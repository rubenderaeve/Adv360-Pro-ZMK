#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          require-prior-idle-ms = <250>;
          tapping-term-ms = <250>;
          quick-tap-ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    // Layer 0 – Base
    // Homerow mods: hold A/S/D/F for GUI/Alt/Ctrl/Shift (left), J/K/L/; for Shift/Ctrl/Alt/GUI (right)
    // Layer keys: T1=toggle fn/numpad, M1=momentary fn/numpad, M2=momentary F-keys,
    //             M3=momentary system, M4=momentary symbols, M5=momentary nav, M6=momentary mouse
    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4      &kp N5   &tog 1                                                                   &mo 3   &kp N6   &kp N7       &kp N8       &kp N9      &kp N0    &kp MINUS
        &kp TAB    &kp Q       &kp W       &kp E        &kp R       &kp T    &none                                                                    &kp INS &kp Y    &kp U        &kp I        &kp O       &kp P     &kp BSLH
        &kp ESC    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F &lt 4 G &mo 4           &kp LCTRL  &kp LALT  &kp LGUI  &kp RCTRL                 &kp DEL &lt 4 H  &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &lt 5 SQT
        &kp LSHFT  &kp Z       &kp X       &kp C        &kp V       &kp B                              &kp HOME   &kp PG_UP                                   &kp N    &kp M        &kp COMMA    &kp DOT     &kp FSLH  &kp RSHFT
        &mo 1      &kp GRAVE   &kp CAPS    &kp LEFT     &lt 1 RIGHT              &kp SPACE  &kp TAB    &kp END    &kp PG_DN   &kp ENTER  &kp BSPC               &kp UP   &lt 6 DOWN   &kp LBKT     &kp RBKT    &mo 2
      >;
    };

    // Layer 1 – Fn / Numpad  (toggle with T1, hold with M1)
    // Left: F-keys (F1-F12 on letter rows), Right: numpad
    fn_numpad {
      display-name = "Fn/Num";
      bindings = <
        &kp EQUAL  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &trans                                                                     &mo 3   &kp N6   &kp KP_NUM   &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
        &kp TAB    &kp F9    &kp F10   &kp F11   &kp F12   &trans    &trans                                                                     &trans  &trans   &kp KP_N7    &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
        &kp ESC    &kp F5    &kp F6    &kp F7    &kp F8    &trans    &trans          &kp LCTRL  &kp LALT  &kp LGUI  &kp RCTRL                   &trans  &trans   &kp KP_N4    &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp KP_DOT
        &kp LSHFT  &kp F1    &kp F2    &kp F3    &kp F4    &trans                              &trans    &trans                                          &trans   &kp KP_N1    &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
        &mo 2      &kp GRAVE &kp CAPS  &kp LEFT  &kp RIGHT              &trans    &trans    &trans    &trans     &trans    &trans                &kp KP_N0  &kp DOWN  &kp KP_DOT    &kp RBKT    &mo 2
      >;
    };

    // Layer 2 – F-Keys  (hold M2)
    // F1-F12 mapped to the number row
    fkeys {
      display-name = "FKeys";
      bindings = <
        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                                          &mo 3  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                            &trans &trans  &trans  &trans  &trans   &trans   &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans                    &trans &trans  &trans  &trans  &trans   &trans   &trans
        &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans                                   &trans  &trans  &trans  &trans   &trans   &trans
        &trans  &trans  &trans  &trans  &trans               &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans   &trans
      >;
    };

    // Layer 3 – System / Mod  (hold M3)
    // Bluetooth profiles, bootloader, RGB, backlight
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    // Layer 4 – Symbols  (hold M4 — inner-left row3 or right-H key)
    // Left: ( $ ) ~ < ! > @ ^ # \ *   Right: - { [ ] } ~ / { = } : "  & + | ?
    symbols {
      display-name = "Sym";
      bindings = <
        &trans  &trans     &trans     &trans    &trans    &trans   &trans                                                                    &trans  &trans     &trans    &trans    &trans     &trans     &trans
        &trans  &kp PRCNT  &kp LPAR   &kp DLLR  &kp RPAR  &trans   &trans                                                                    &trans  &kp MINUS  &kp LBRC  &kp LBKT  &kp RBKT   &kp RBRC   &kp TILDE
        &trans  &kp TILDE  &kp LT     &kp EXCL  &kp GT    &trans   &trans          &trans  &trans  &trans  &trans                            &trans  &trans     &kp LBRC  &kp EQUAL &kp RBRC   &kp COLON  &kp DQT
        &trans  &kp AT     &kp CARET  &kp HASH  &kp BSLH  &kp STAR                         &trans  &trans                                           &trans     &kp AMPS  &kp PLUS  &kp PIPE   &kp QMARK  &trans
        &trans  &trans     &trans     &trans    &trans               &trans  &trans  &trans  &trans  &trans  &trans                                   &trans     &trans    &trans    &trans     &trans
      >;
    };

    // Layer 5 – Navigation  (hold M5 — apostrophe key)
    // WASD arrows: W=Up, A=Left, S=Down, D=Right
    nav {
      display-name = "Nav";
      bindings = <
        &trans  &trans    &trans    &trans     &trans  &trans  &trans                                                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans    &kp UP    &trans     &trans  &trans  &trans                                                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans          &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans    &trans    &trans     &trans  &trans                          &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans    &trans    &trans     &trans              &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
      >;
    };

    // Layer 6 – Mouse buttons  (hold M6 — right-bottom-row second key)
    // MB1/MB3/MB2 on K/L/; keys (right hand, easy thumb reach)
    mouse {
      display-name = "Mouse";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                          &trans  &trans    &trans    &trans    &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                          &trans  &trans    &trans    &trans    &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans                  &trans  &trans    &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans                                  &trans    &trans    &trans    &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans    &trans  &trans
      >;
    };

  };
};
